# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
# Encrypts sensitive PII at rest (Aadhaar/PAN/bank account numbers). Falls
# back to DJANGO_SECRET_KEY if unset, but set your own in production —
# rotating DJANGO_SECRET_KEY later would otherwise break decryption of
# already-stored data. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
FIELD_ENCRYPTION_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Which settings module to use — "mall_of_garhwa.settings.development" (default
# for local work) or "mall_of_garhwa.settings.production" (Docker/real deploys).
DJANGO_SETTINGS_MODULE=mall_of_garhwa.settings.development
# Production only — set to True once a real reverse proxy in front of this
# app is terminating TLS. Leave False for a first Docker boot over plain HTTP.
SECURE_SSL_REDIRECT=False

# Database — defaults to SQLite, zero setup (db.sqlite3 created automatically).
# To use MySQL instead, uncomment DB_ENGINE below and fill in the rest
# (requires `mysqlclient` — see requirements.txt).
# DB_ENGINE=mysql
# DB_NAME=zkart
# DB_USER=zkart_user
# DB_PASSWORD=change-this-password
# DB_HOST=localhost
# DB_PORT=3306

# To use PostgreSQL instead, set DB_ENGINE=postgresql with the same variables
# (DB_PORT default 5432). Docker Compose sets these automatically — see
# docker-compose.yml / DOCKER.md, you don't need to duplicate them here.

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional — S3/Cloudflare R2 for media storage. Leave blank to store
# uploads on local disk (fine for a single-server deploy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# JWT
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Celery (background jobs) — reuses the Redis above by default
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# APITxT — SMS / WhatsApp / Voice OTP (https://apitxt.com)
APITXT_API_KEY=
APITXT_SENDER_ID=MALLGW

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mall-of-garhwa-media
AWS_S3_ENDPOINT_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Delivery pricing
DELIVERY_CHARGE=25
FREE_DELIVERY_THRESHOLD=299
ORDER_ACCEPT_TIMEOUT_MINUTES=5
DELIVERY_PARTNER_PAYOUT_PER_ORDER=20

# Anthropic API — powers the daily AI sales summary (apps/reports)
ANTHROPIC_API_KEY=

# Web Push — run `python manage.py generate_vapid_keys` once to get these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_ADMIN_EMAIL=admin@zkart.shop

# Publicly reachable URL for this backend — needed so Facebook/Instagram
# can fetch campaign images (a relative /media/... path won't work for them).
SITE_URL=http://localhost:8000

# Meta Graph API — for Campaign posting to Facebook/Instagram. Get these
# from https://developers.facebook.com — create a Meta Business app, connect
# your Facebook Page, generate a long-lived Page Access Token, and link an
# Instagram Business account to that Page for INSTAGRAM_BUSINESS_ACCOUNT_ID.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
ANTHROPIC_MODEL=claude-sonnet-4-6

DEFAULT_FROM_EMAIL=zKart.shop <noreply@zkart.shop>
# Gmail: use smtp.gmail.com + an App Password (not your normal password).
# Leave blank locally — dev settings print emails to the console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=
